-- SCANNER CORRETO para o GitHub
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4","M4A1"}

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

-- AVISA QUE O SCANNER INICIOU
sendToDiscord("📢 SCANNER INICIADO no servidor: " .. game.PlaceId)

task.wait(3)

local found = {}

for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end
    
    local inv = player:FindFirstChild("GunInventory")
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name
                for _, alvo in ipairs(ITENS_ALVO) do
                    if nome and nome:lower():find(alvo:lower()) then
                        local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                        table.insert(found, string.format("%s | %s | %d balas", player.Name, nome, mag))
                        sendToDiscord("🔫 ENCONTRADO: " .. player.Name .. " | " .. nome)
                    end
                end
            end
        end
    end
    
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        table.insert(found, string.format("%s | BackpackTier4 | N/A", player.Name))
        sendToDiscord("🎒 BACKPACK: " .. player.Name)
    end
end

if #found > 0 then
    sendToDiscord("⚠️ TOTAL: " .. #found .. " item(ns) encontrados")
else
    sendToDiscord("✅ Nada encontrado")
end

sendToDiscord("🔄 Voltando para o hub em 3 segundos...")
task.wait(3)
TeleportService:Teleport(HUB_PLACE_ID)
