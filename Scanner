local Library = require(game.ReplicatedStorage:WaitForChild("Library"))

local SCANNER_URL = "https://raw.githubusercontent.com/cajiwghdtyasdnhatfy/Acaswartqaawr/refs/heads/main/Scanner"
local HUB_PLACE_ID = 15327728308

local SERVERS_LIST = {
    "Abyss", "Aftermath", "Alpha", "Anarchy", "Armageddon",
    "Banshee", "Blight", "Bravo", "Carnage", "Cataclysm",
    "Charlie", "Chaos", "Delta", "Despair", "Doom", "Dread",
    "Echo", "Eclipse", "Eerie", "Fallout", "Foxtrot", "Frenzy",
    "Gloom", "Golf", "Grave", "Grim", "Harrow", "Havoc", "Hotel",
    "Ignition", "India", "Inferno", "Jagged", "Judgement", "Juliett",
    "Kilo", "Kraken", "Krypt", "Lament", "Lima", "Limbo", "Malice", "Marrow",
    "Mike", "Morbid", "Necrosis", "November", "Null", "Oblivion", "Obsidian",
    "Oscar", "Papa", "Pestilence", "Plague", "Quarantine", "Quandary", "Quebec",
    "Ragnarok", "Ravage", "Reaper", "Revenant", "Romeo", "Ruin", "Scourge",
    "Sentinel", "Shade", "Sierra", "Tango", "Tempest", "Torment", "Ulcer", "Unholy"
}

local scannedServers = {}
local currentIndex = 1

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq",
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

local function saveProgress()
    pcall(function()
        writefile("scanner_progress.txt", currentIndex .. "\n" .. HttpService:JSONEncode(scannedServers))
    end)
end

local function loadProgress()
    pcall(function()
        local data = readfile("scanner_progress.txt")
        if data then
            local lines = {}
            for line in data:gmatch("[^\r\n]+") do
                table.insert(lines, line)
            end
            currentIndex = tonumber(lines[1]) or 1
            scannedServers = HttpService:JSONDecode(lines[2]) or {}
        end
    end)
end

local function goToNextServer()
    if currentIndex > #SERVERS_LIST then
        sendToDiscord("🏁 **SCAN FINALIZADO!**")
        return false
    end
    
    local serverName = SERVERS_LIST[currentIndex]
    currentIndex = currentIndex + 1
    
    if scannedServers[serverName] then
        return goToNextServer()
    end
    
    scannedServers[serverName] = true
    saveProgress()
    
    print("[HUB] Entrando em: " .. serverName)
    sendToDiscord("🔄 **Indo para:** " .. serverName .. " (" .. currentIndex-1 .. "/" .. #SERVERS_LIST .. ")")
    
    Library.Network:Fire("Player.JoinServer", serverName)
    return true
end

loadProgress()

if game.PlaceId == HUB_PLACE_ID then
    sendToDiscord("🚀 **Hub Scanner Iniciado!**")
    task.wait(3)
    goToNextServer()
end

game:GetService("Players").LocalPlayer.OnTeleport:Connect(function()
    task.wait(5)
    if game.PlaceId == HUB_PLACE_ID then
        print("[HUB] Voltou! Próximo servidor...")
        goToNextServer()
    end
end)
