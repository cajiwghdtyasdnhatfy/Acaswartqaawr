local function sendEmbed(title, description, color)
    local embed = {
        title = title,
        description = description,
        color = color
    }
    
    local body = {
        embeds = {embed},
        username = "Cargo Scanner"
    }
    
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode(body)
            })
        end)
    end
end

local function recursiveFind(data, searchKey, visited, depth)
    visited = visited or {}
    depth = depth or 0
    if depth > 10 then return false end
    if type(data) == "string" then
        return data:find(searchKey) ~= nil
    elseif type(data) == "table" then
        if visited[data] then return false end
        visited[data] = true
        for _, value in pairs(data) do
            if recursiveFind(value, searchKey, visited, depth + 1) then
                return true
            end
        end
    end
    return false
end

local playerData = {} -- Para agrupar dados por jogador
local zombieCount = 0
local zombieList = {}

-- Coletar dados dos jogadores
for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end
    
    local playerInfo = {
        name = player.Name,
        weapons = {},
        hasTier4 = false
    }
    
    local inv = player:WaitForChild("GunInventory", 3)
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name
                for _, alvo in ipairs(ITENS_ALVO) do
                    if nome and nome:lower():find(alvo:lower()) then
                        local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                        table.insert(playerInfo.weapons, {name = nome, ammo = mag})
                        break
                    end
                end
            end
        end
    end
    
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        playerInfo.hasTier4 = true
    end
    
    if #playerInfo.weapons > 0 or playerInfo.hasTier4 then
        table.insert(playerData, playerInfo)
    end
end

-- Enviar embed para cada jogador com todos os seus itens
for _, data in ipairs(playerData) do
    local description = string.format("**Player:** %s\n", data.name)
    
    if #data.weapons > 0 then
        description = description .. "\n**Weapons Found:**\n"
        for _, weapon in ipairs(data.weapons) do
            description = description .. string.format("- %s (%d bullets)\n", weapon.name, weapon.ammo)
        end
        description = description .. string.format("\n<@&%s>", CARGO_GUNS)
    end
    
    if data.hasTier4 then
        if #data.weapons > 0 then
            description = description .. "\n\n"
        end
        description = description .. string.format("**Backpack:** Backpack Tier 4\n<@&%s>", CARGO_TIER4)
    end
    
    sendEmbed(
        "Tier4",
        description,
        16776960
    )
end

