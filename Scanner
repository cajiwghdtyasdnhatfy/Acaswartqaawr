-- SCANNER - Roda em cada servidor (usa TeleportData)
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4"}

-- RECUPERA OS DADOS DO TELEPORTE
local teleportData = TeleportService:GetLocalPlayerTeleportData()

print("[SCANNER] TeleportData recebido:", teleportData)

if teleportData and teleportData.action == "scan" then
    print("[SCANNER] Modo scan ativado para: " .. teleportData.serverName)
end

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

local function scan()
    print("[SCANNER] Iniciando scan...")
    local found = {}
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == Players.LocalPlayer then continue end
        
        local inv = player:FindFirstChild("GunInventory")
        if inv then
            for _, obj in ipairs(inv:GetChildren()) do
                if obj:IsA("ObjectValue") and obj.Value then
                    local nome = obj.Value.Name:lower()
                    for _, alvo in ipairs(ITENS_ALVO) do
                        if nome:find(alvo) then
                            local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                            table.insert(found, string.format("**%s** | %s | %d balas", player.Name, obj.Value.Name, mag))
                        end
                    end
                end
            end
        end
        
        local bp = player:GetAttribute("EquipmentBackpack")
        if bp and tostring(bp):lower():find("backpacktier4") then
            table.insert(found, string.format("**%s** | BackpackTier4 | N/A", player.Name))
        end
    end
    
    local serverName = teleportData and teleportData.serverName or "Desconhecido"
    
    if #found > 0 then
        sendToDiscord("⚠️ **" .. serverName .. "** - " .. #found .. " item(ns):\n" .. table.concat(found, "\n"))
    else
        sendToDiscord("✅ **" .. serverName .. "** | Nada encontrado.")
    end
    
    print("[SCANNER] Scan finalizado, voltando ao hub...")
    task.wait(3)
    
    -- Volta pro hub com os dados atualizados
    local options = Instance.new("TeleportOptions")
    options:SetTeleportData({
        action = "return",
        nextIndex = (teleportData and teleportData.currentIndex or 1),
        scannedServers = teleportData and teleportData.scannedServers or {}
    })
    
    TeleportService:Teleport(HUB_PLACE_ID, options)
end

task.wait(5)
scan()
