-- === SCANNER MELHORADO + DEBUG ===
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4", "fists"}

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

sendToDiscord("📡 **SCANNER INICIADO** | Servidor: `" .. game.PlaceId .. "`")
task.wait(5)  -- Mais tempo para inventários carregarem

local found = {}
local totalItens = 0

for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end

    print("[Scanner] Verificando jogador: " .. player.Name) -- Debug no console

    -- === GUN INVENTORY ===
    local inv = player:FindFirstChild("GunInventory") or player:WaitForChild("GunInventory", 3)
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name
                if nome then
                    for _, alvo in ipairs(ITENS_ALVO) do
                        if nome:lower():find(alvo:lower()) then
                            local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                            table.insert(found, "**" .. player.Name .. "** | `" .. nome .. "` | " .. mag .. " balas")
                            totalItens += 1
                            sendToDiscord("🔫 **ENCONTRADO:** " .. player.Name .. " | " .. nome .. " | " .. mag .. " balas")
                        end
                    end
                end
            end
        end
    else
        print("[Scanner] GunInventory não encontrado para " .. player.Name)
    end

    -- === BACKPACK T4 ===
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        table.insert(found, "**" .. player.Name .. "** | `BackpackTier4`")
        totalItens += 1
        sendToDiscord("🎒 **BACKPACK T4:** " .. player.Name)
    end
