-- SCANNER - Versão que envia "⚠️ Mundo Aftermath 🧟"
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4","fists"}

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

local function getServerName()
    local success, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end
    
    local name = success and info.Name or tostring(game.PlaceId)
    
    local servers = {
        "Abyss", "Aftermath", "Alpha", "Anarchy", "Armageddon",
        "Banshee", "Blight", "Bravo", "Carnage", "Cataclysm",
        "Charlie", "Chaos", "Delta", "Despair", "Doom", "Dread",
        "Echo", "Eclipse", "Eerie", "Fallout", "Foxtrot", "Frenzy",
        "Gloom", "Golf", "Grave", "Grim", "Harrow", "Havoc", "Hotel",
        "Ignition", "India", "Inferno", "Jagged", "Judgement", "Juliett",
        "Kilo", "Kraken", "Krypt", "Lament", "Lima", "Limbo", "Malice", "Marrow",
        "Mike", "Morbid", "Necrosis", "November", "Null", "Oblivion", "Obsidian",
        "Oscar", "Papa", "Pestilence", "Plague", "Quarantine", "Quandary", "Quebec",
        "Ragnarok", "Ravage", "Reaper", "Revenant", "Romeo", "Ruin", "Scourge",
        "Sentinel", "Shade", "Sierra", "Tango", "Tempest", "Torment", "Ulcer", "Unholy"
    }
    
    for _, s in pairs(servers) do
        if string.find(name, s) then
            return s
        end
    end
    return "Desconhecido"
end

local serverName = getServerName()

-- ENVIA O AVISO
sendToDiscord("⚠️ Mundo " .. serverName .. " 🧟")

-- ESCANEIA
local found = {}

for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end
    
    local inv = player:FindFirstChild("GunInventory")
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name:lower()
                for _, alvo in ipairs(ITENS_ALVO) do
                    if nome:find(alvo) then
                        local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                        table.insert(found, string.format("%s | %s | %d balas", player.Name, obj.Value.Name, mag))
                    end
                end
            end
        end
    end
    
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        table.insert(found, string.format("%s | BackpackTier4 | N/A", player.Name))
    end
end

-- ENVIA OS ITENS
if #found > 0 then
    for _, item in pairs(found) do
        sendToDiscord(item)
    end
else
    sendToDiscord("Nada encontrado.")
end

-- VOLTA PRO HUB
task.wait(3)
TeleportService:Teleport(HUB_PLACE_ID)
