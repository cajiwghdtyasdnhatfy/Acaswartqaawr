local scanned = {}
local currentIndex = 1
local scanningActive = true

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

-- ====================== SCANNER ======================
local function runScanner()
    sendToDiscord("📢 **SCANNER INICIADO** no servidor: " .. game.PlaceId)
    task.wait(5)

    local ITENS_ALVO = {"barret50", "renellim4", "m79", "backpacktier4", "fists"}
    local found = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player == Players.LocalPlayer then continue end

        local inv = player:FindFirstChild("GunInventory")
        if inv then
            for _, obj in ipairs(inv:GetChildren()) do
                if obj:IsA("ObjectValue") and obj.Value then
                    local nome = obj.Value.Name
                    for _, alvo in ipairs(ITENS_ALVO) do
                        if nome and nome:lower():find(alvo:lower()) then
                            local mag = obj:FindFirstChild("BulletsInMagazine") and obj.BulletsInMagazine.Value or 0
                            table.insert(found, string.format("%s | %s | %d balas", player.Name, nome, mag))
                            sendToDiscord("🔫 ENCONTRADO: " .. player.Name .. " | " .. nome)
                        end
                    end
                end
            end
        end

        local bp = player:GetAttribute("EquipmentBackpack")
        if bp and tostring(bp):lower():find("backpacktier4") then
            table.insert(found, string.format("%s | BackpackTier4", player.Name))
            sendToDiscord("🎒 BACKPACK: " .. player.Name)
        end
    end

    if #found > 0 then
        sendToDiscord("⚠️ **TOTAL ENCONTRADO:** " .. #found .. " item(ns)")
    else
        sendToDiscord("✅ Nada encontrado neste servidor")
    end

    sendToDiscord("🔄 Voltando para o Hub em 4 segundos...")
    task.wait(4)
    TeleportService:Teleport(HUB_PLACE_ID)
end

-- ====================== HUB CONTROLLER ======================
local function joinNextServer()
    if not scanningActive then return end
    if currentIndex > #SERVERS then
        sendToDiscord("✅ **SCAN FINALIZADO** - Todos os servidores foram escaneados!")
        scanningActive = false
        return
    end

    local serverName = SERVERS[currentIndex]
    currentIndex += 1

    if scanned[serverName] then return joinNextServer() end

    scanned[serverName] = true
    print("[Hub] Entrando em: " .. serverName)
    sendToDiscord("🔄 **Entrando em:** " .. serverName .. " (" .. (currentIndex-1) .. "/" .. #SERVERS .. ")")

    Library.Network:Fire("Player.JoinServer", serverName)
end

