local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

local function joinNextServer()
    if isProcessing then return end
    isProcessing = true

    -- Verifica se já passou por todos os servidores da lista
    if currentIndex > #SERVERS then
        currentIndex = 1
        scanned = {}
        -- Limpa o arquivo TXT ao reiniciar o ciclo
        if writefile then writefile(FILE_NAME, "") end
        isProcessing = false
        task.wait(5)
        return joinNextServer()
    end

    local serverName = SERVERS[currentIndex]
    currentIndex += 1

    -- Se já escaneou, pula silenciosamente pro próximo
    if scanned[serverName] then 
        isProcessing = false
        return joinNextServer() 
    end

    -- Marca como visitado e salva no TXT
    scanned[serverName] = true
    if appendfile then
        appendfile(FILE_NAME, serverName .. "\n")
    elseif writefile then
        -- Fallback caso o executor não suporte appendfile
        local currentData = ""
        if isfile and isfile(FILE_NAME) then
            currentData = readfile(FILE_NAME)
        end
        writefile(FILE_NAME, currentData .. serverName .. "\n")
    end

    -- Só manda o nome do servidor pro Discord
    sendToDiscord("Server: " .. serverName)

    if Library and Library.Network then
        Library.Network:Fire("Player.JoinServer", serverName)
    end

    task.wait(6)
    isProcessing = false
end

