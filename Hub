}

local scanned = {}
local currentIndex = 1
local isProcessing = false
local hasStarted = false

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = HttpService:JSONEncode({content = msg})
            })
        end)
    end
end

local function joinNextServer()
    if isProcessing then return end
    isProcessing = true

    -- Verifica se já passou por todos os servidores da lista
    if currentIndex > #SERVERS then
        sendToDiscord("🔄 **Ciclo finalizado** - Reiniciando histórico de servidores...")
        currentIndex = 1
        scanned = {} -- Limpa a memória para recomeçar
        isProcessing = false
        task.wait(5)
        return joinNextServer()
    end

    local serverName = SERVERS[currentIndex]
    currentIndex += 1

    -- Se já escaneou, pula silenciosamente pro próximo
    if scanned[serverName] then 
        isProcessing = false
        return joinNextServer() 
    end

    -- Marca como visitado
    scanned[serverName] = true

    sendToDiscord("Server: " .. serverName)

    if Library and Library.Network then
        Library.Network:Fire("Player.JoinServer", serverName)
    end

    task.wait(6)
    isProcessing = false
end

-- Detecção de Falhas (Se o servidor estiver cheio, pula na hora)
TeleportService.TeleportInitFailed:Connect(function(player, result, errorMessage)
    if errorMessage and string.find(string.lower(errorMessage), "full") then
        task.wait(1)
        isProcessing = false
        joinNextServer()
    end
end)

