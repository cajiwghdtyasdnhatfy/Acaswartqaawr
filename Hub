local WEBHOOK_URL = "https://discord.com/api/webhooks/1514031008654295040/efj6sTrpu2HRERFEALNMWpgsCAT0b_7V_S4oFrwclE9rkcfQ8si3EfSpaZ3rNTTnAzVq"
local HUB_PLACE_ID = 15327728308

local SERVERS = { ... sua lista completa ... }  -- mantenha a lista

local scanned = {}
local currentIndex = 1
local scanningActive = true
local isProcessing = false   -- <--- Anti duplicação principal

local function sendToDiscord(msg)
    local req = syn and syn.request or http_request or request
    if req then
        pcall(function()
            req({Url = WEBHOOK_URL, Method = "POST", Headers = {["Content-Type"] = "application/json"}, Body = HttpService:JSONEncode({content = msg})})
        end)
    end
end

local function joinNextServer()
    if not scanningActive or isProcessing then 
        print("Ignorando chamada duplicada...")
        return 
    end
    isProcessing = true

    if currentIndex > #SERVERS then
        sendToDiscord("🔄 **Ciclo completo** - Reiniciando do início...")
        currentIndex = 1
        scanned = {}
        task.wait(12)
        isProcessing = false
        return joinNextServer()
    end

    local serverName = SERVERS[currentIndex]
    currentIndex += 1

    if scanned[serverName] then 
        isProcessing = false
        return joinNextServer() 
    end

    scanned[serverName] = true

    print("[Hub] Entrando em: " .. serverName)
    sendToDiscord("🔄 **Entrando em:** " .. serverName .. " (" .. (currentIndex-1) .. "/" .. #SERVERS .. ")")

    if Library and Library.Network then
        Library.Network:Fire("Player.JoinServer", serverName)
    end

    task.wait(4)   -- delay antes de liberar próxima ação
    isProcessing = false
end

